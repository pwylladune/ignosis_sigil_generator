PORT=3001
NODE_ENV=development

# Web app origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:8642

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# IGNOSIS Joule (ADR 2026-10-25-ignosis-joule-token). Create it with `npm run mint:devnet`.
# Devnet mint: 2Aj4PVH2RoxdQScMHkvjzPR4whMZiGUWwvZoZyHMjwNA
# Never 7xKXtg…sgAsU: that is Samoyed Coin (SAMO).
JOULE_MINT_ADDRESS=

# Treasury keypair, JSON byte array (e.g. the contents of treasury.keypair.json).
# If empty or invalid, rites are disabled; no keypair is ever generated.
TREASURY_PRIVATE_KEY=

# Proxies in front of the API whose X-Forwarded-For entry is trusted (1 on Fly.io).
# Leave 0 when clients reach the API directly.
TRUST_PROXY_HOPS=0

# SQLite ledger (one burn per rite; a package's rites are counted against its payment).
# Must be on persistent, writable storage. The packages (3, 7 and 21 rites) and their
# Play products are fixed in src/services/ritePacks.ts.
RITE_LEDGER_PATH=./data/rite-ledger.sqlite

# Stripe Checkout for web rites. All four are needed, or web payment stays off.
# Test keys (sk_test_) only with devnet; live keys (sk_live_) only with mainnet-beta.
STRIPE_SECRET_KEY=
# Endpoint signing secret: from `stripe listen` locally, or the dashboard endpoint for
# https://<api-host>/api/v1/stripe/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created).
STRIPE_WEBHOOK_SECRET=
# One Stripe price per package: pack3=price_…,pack7=price_…,pack21=price_…
STRIPE_RITE_PRICES=
# Where Stripe returns the payer (serves /rite-paid.html), e.g. https://ignosis.net
WEB_ORIGIN=

# Android rites (Google Play Billing): the service account JSON, on one line.
# The Google Cloud project must have the Android Publisher API enabled, and the account
# must be invited in Play Console with permission to view and manage orders.
# Off mainnet only Play test purchases (license testers) are accepted; on mainnet only real ones.
GOOGLE_PLAY_SERVICE_ACCOUNT=

# In-App Purchase Credentials
APPLE_BUNDLE_ID=net.ignosis.studio
GOOGLE_PACKAGE_NAME=net.ignosis.studio
