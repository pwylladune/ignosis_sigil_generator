PORT=3001
NODE_ENV=development

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Token & Program Addresses
# No $IGNOSIS mint exists yet. Do not use 7xKXtg…sgAsU: that is Samoyed Coin (SAMO).
IGNOSIS_MINT_ADDRESS=
IGNOSIS_DECIMALS=9
IGNOSIS_PROGRAM_ID=

# Treasury Keypair (JSON array format, e.g. [12,34,56,...])
# JSON byte array. If empty or invalid the treasury is disabled; no keypair is ever generated.
TREASURY_PRIVATE_KEY=

# In-App Purchase Credentials
APPLE_BUNDLE_ID=com.ignosis.sigilgenerator
GOOGLE_PACKAGE_NAME=com.ignosis.sigilgenerator
